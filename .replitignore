# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/.pythonlibs/

# Casino runtime state contains balances, payment IDs, and audit records.
/casino_bot/casino_data.json
/casino_bot/critical_data.json
/casino_bot/balances_backup.json
/casino_bot/processed_payments.json
/casino_bot/processed_deposit_txids.json
/casino_bot/transaction_log.json
/casino_bot/audit_log.json
/casino_bot/tip_system.db
/casino_bot/.bot_config
/casino_bot/emergency_*.json
/casino_bot/user_data_export_*.json
